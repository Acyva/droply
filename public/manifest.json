{
  "name": "Droply",
  "short_name": "Droply",
  "description": "Your personal bookmark and notes vault",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#fafaf9",
  "theme_color": "#1c1917",
  "orientation": "any",
  "scope": "/",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Link",
      "short_name": "Add",
      "description": "Quick add a new link or note",
      "url": "/share",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false
}
