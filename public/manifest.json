{
  "name": "Droply",
  "short_name": "Droply",
  "description": "Your personal bookmark and notes vault",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#fafaf9",
  "theme_color": "#1c1917",
  "orientation": "any",
  "scope": "/",
  "icons": [
    {
      "src": "/Untitled-iOS-Default-1024@1x.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Link",
      "short_name": "Add",
      "description": "Quick add a new link or note",
      "url": "/share",
      "icons": [{ "src": "/Untitled-iOS-Default-1024@1x.png", "sizes": "1024x1024", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false
}
